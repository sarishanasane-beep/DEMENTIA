# SmartMind Server — Environment Configuration
# Copy this to .env and fill in real values

# ---- OmniRoute / Kiro AI ----
# OmniRoute provides access to Claude Sonnet 4.5 via an OpenAI-compatible API.
# OmniRoute must be running locally (same instance used by Claude Code).
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key-here

# Model ID — use kr/claude-sonnet-4.5 (NOT kr/claude-sonnet-4.5-medium which is rejected)
OPENAI_MODEL=kr/claude-sonnet-4.5

# Set to "real" to use OmniRoute; "mock" for demo mode
AI_MODE=mock

# ---- Server ----
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ---- Bhashini (Language Services) ----
# Set to "real" to use Bhashini STT/TTS; "mock" for fallback
BHASHINI_MODE=mock
BHASHINI_API_URL=
BHASHINI_API_KEY=

# ---- Security Notes ----
# NEVER commit .env with real API keys.
# API keys must stay server-side only — never exposed to the frontend.
# OmniRoute credentials are the same ones used by Claude Code.
